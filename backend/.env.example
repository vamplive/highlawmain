# ── 서버 설정 ──
# macOS의 AirPlay Receiver가 5000을 점유하므로 5001을 기본값으로 사용
PORT=5001

# ── CORS 허용 도메인 (쉼표 구분) ──
# ALLOWED_ORIGINS=https://younjeong.com,https://www.younjeong.com

# ── 사이트맵/수신거부 링크용 정식 도메인 ──
# SITE_URL=https://younjeong.com
# APP_URL=https://younjeong.com

# ── 파일 저장 경로 (기본: backend/data) ──
# STORAGE_PATH=/var/data/yjlaw

# ── CSRF 시크릿 (프로덕션 필수, 32바이트 이상의 hex 권장) ──
# 예시 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# ── 시크릿 볼트 키 (admin_users.totp_secret 등 민감 시크릿 AES-256-GCM 암호화) ──
# 32바이트 hex(64자) 또는 base64(32바이트). 운영 환경에서 미설정 시 부팅·암복호화 시 에러.
# 미설정이면 폴백으로 APP_SECRET/ADMIN_SESSION_SECRET 에서 scrypt 도출 시도.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# ── 분석 IP 해시 salt (page_views 일자별 dedupe용) ──
# page_views.ip 컬럼에는 마스킹된 IP(예: 1.2.3.0)만 저장하며,
# 본 salt는 일자별 SHA-256 해시(세션 ID 생성)에 사용된다.
# 일자가 바뀌면 같은 IP라도 다른 해시가 나오므로 장기 추적이 불가능하다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_IP_SALT=

# ── 관리자 초기 계정 (최초 실행 시 자동 생성, 8자 이상 필수) ──
# 프로덕션(NODE_ENV=production)에서 미설정이면 서버 부팅이 차단됩니다.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=   # ← 반드시 안전한 비밀번호로 변경

# ── Google Apps Script 웹훅 URL (상담/Q&A 알림) ──
# 상담 신청과 법률 Q&A 질문 접수 시 동일 웹훅으로 관리자에게 알림 전송
# payload.type 으로 구분: "qna_question" = Q&A 신규, 미설정 시 = 상담
APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── 알리고(Aligo) SMS API ──
# 알리고 사이트(https://smartsms.aligo.in) > 문자API > 신청/인증 메뉴에서 발급
ALIGO_API_KEY=           # 발급받은 API Key
ALIGO_USER_ID=           # 알리고 로그인 ID
ALIGO_SENDER=            # 등록된 발신번호 (예: 010-1234-5678)
ALIGO_ADMIN_RECEIVER=    # 상담 접수 시 알림받을 관리자 번호 (미설정 시 SMS 알림 비활성화)
ALIGO_TEST_MODE=Y        # Y = 테스트 모드 (실제 발송·차감 없음, 응답만 확인) / N = 실제 발송

# ── Anthropic Claude API (영수증 OCR) ──
# https://console.anthropic.com/settings/keys 에서 발급
# 미설정 시 영수증 업로드는 tesseract 휴리스틱 파서로 자동 폴백
ANTHROPIC_API_KEY=
# 모델 변경 시 (기본: claude-sonnet-4-6 — 영수증 한국어 OCR 정확도 우선)
# Haiku 4.5는 작은 한국어 글자·카드사명을 자주 놓쳐 권장하지 않음
# RECEIPT_AI_MODEL=claude-sonnet-4-6

# ── Sentry 에러 수집 (선택, DSN 미설정 시 비활성) ──
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=v1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0
